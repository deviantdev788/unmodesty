
load("//anybuild/tools:node_static.bzl", "nodestatic_build", "nodestatic_config")
load("//anybuild/tools:staticfile.bzl", "staticfile_serve")

config = nodestatic_config(
    schema = 1,
    commands = {
        "start": "static-web-server --root=/opt/static_app --log-level=info --port=$PORT --page-fallback=/opt/static_app/index.html",
    },
    sws_version = "2.38.0",
    static_dir = "dist",
    node_package_manager = "npm",
    node_framework = "vite",
    node_server = "node",
    node_build_command = "npm run build",
    node_version = "24",
    node_install_requires_all_files = True,
)

build = nodestatic_build(config)

staticfile_serve(config, build, name = "unmodesty")
